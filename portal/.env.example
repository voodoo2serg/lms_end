# Portal public host (docs / chrome). Do not deploy from this phase.
PORTAL_HOST=lms.solo-pr.ru
NEXT_PUBLIC_PORTAL_HOST=lms.solo-pr.ru

# HMAC secret for signed portal session cookies (≥16 chars; required in production).
PORTAL_SESSION_SECRET=dev-portal-session-secret-change-me

# Optional: delegate ALL /api/meetings/* to lms_end adapter (same store).
# Leave empty → portal local in-process store (honest “LMS off / stub”).
# On shared VPS after compose.lms up: http://127.0.0.1:18083 (NOT 18080 — voronka).
LMS_END_URL=
# Bearer for adapter meeting routes (MEETINGS_API_TOKEN / VORONKA_LMS_TOKEN).
LMS_END_TOKEN=
MEETINGS_API_TOKEN=

# Stub staff credentials (dev only; replace with Keycloak later).
STUB_STAFF_EMAIL=lms@solo-pr.ru
STUB_STAFF_PASSWORD=changeme
STUB_LEARNER_EMAIL=learner@solo-pr.ru
STUB_LEARNER_PASSWORD=changeme

# BBB media plane — NEVER the current VPS. External host when decided.
BBB_MEDIA_PLANE_HOST=
BBB_JOIN_STUB=1
