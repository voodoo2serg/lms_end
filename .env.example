# Public HTTPS name. Add an A record to this server before requesting a certificate.
DOMAIN=voronka.familypaper.online
# Host loopback port. Nginx on a shared server proxies here. Do not publish it on 0.0.0.0.
API_PORT=18080
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://funnel:CHANGE_ME@db:5432/funnel
REDIS_URL=redis://redis:6379/0
ADMIN_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Each connection refers to these variable NAMES, never the token itself.
TG_MAIN_TOKEN=
TG_MAIN_WEBHOOK_SECRET=
MAX_MAIN_TOKEN=
MAX_MAIN_WEBHOOK_SECRET=
VK_MAIN_TOKEN=
VK_MAIN_WEBHOOK_SECRET=
VK_MAIN_CONFIRMATION=
VK_API_VERSION=5.199

# CRM browser credentials: docker compose exec api python -m scripts.create_crm_owner
# Robokassa: test invoices never create live money or grant paid access.
ROBOKASSA_LOGIN=
ROBOKASSA_TEST=1
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH=sha256
# Enable only after the shop's separate fiscalization process is configured.
ROBOKASSA_LIVE_READY=0
# SMTP requires STARTTLS; recovery and explicitly launched email campaigns.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Full /api/gateway/v1/chat/completions endpoint, server token, project->model aliases.
RAG_API_URL=
RAG_API_TOKEN=
RAG_PROJECT_MODELS={}
BOT_MESSAGES_PER_SECOND=20

# LMS integration: one installation = one project. UUID of an existing CRM project.
PLATFORM_PROJECT_ID=
SITE_ORIGIN=https://solo-pr.ru
API_DOMAIN=api.solo-pr.ru
AUTH_DOMAIN=auth.solo-pr.ru
LEARN_DOMAIN=learn.solo-pr.ru
OPENOLAT_URL=https://learn.solo-pr.ru
OPENOLAT_API_USER=
OPENOLAT_API_KEY=
# Official release artifact and verified checksum; never use development/master in production.
OPENOLAT_WAR_URL=
OPENOLAT_WAR_SHA256=
OPENOLAT_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
LEARNING_DB_ROOT_PASSWORD=
KEYCLOAK_VERSION=
KEYCLOAK_ADMIN=platform-owner
KEYCLOAK_ADMIN_PASSWORD=
OPENOLAT_OIDC_SECRET=
OIDC_ISSUER=https://auth.solo-pr.ru/realms/solo-pr
OIDC_AUDIENCE=solo-api
OIDC_CLIENT_ID=solo-site
OIDC_CLIENT_SECRET=
# Exact Keycloak subject -> existing CRM admin id. No automatic staff elevation.
OIDC_STAFF_MAP={}
SITE_BRIDGE_TOKEN=
# On server A only: no NEXT_PUBLIC_ secrets.
LEARNING_API_URL=https://api.solo-pr.ru
LEARNING_SESSION_KEY=
# HTTP is permitted only for a deliberate isolated development network.
ALLOW_INTERNAL_HTTP=0
# Paid models configured in RAGA; keep provider billing keys in RAGA, not in this repo/site.
AI_ENABLED=0
RAGA_URL=
RAGA_FUNNEL_ALIAS=
RAGA_FUNNEL_TOKEN=
RAGA_MANAGER_ALIAS=
RAGA_MANAGER_TOKEN=
# Add per-course variables such as RAGA_PR_TOKEN, referenced by Course.raga_token_env.
AI_DAILY_BUDGET_MICRO_USD=5000000
AI_MAX_REQUEST_MICRO_USD=50000
AI_USER_DAILY_REQUESTS=30
